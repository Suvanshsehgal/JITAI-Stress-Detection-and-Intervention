# Ebb JITAI Backend Configuration
# Copy this file to backend/.env and fill in real values. Never commit .env.

# Google Gemini API keys (used by the buddy chat).
# Put up to 5 keys, comma-separated. They are tried in order; when one is
# rate-limited or rejected, the next key is used. If all fail, rule-based
# replies are returned so the chat never breaks.
# Get keys at: https://aistudio.google.com/app/apikey
GEMINI_API_KEYS=your_key_1,your_key_2,your_key_3,your_key_4,your_key_5
GEMINI_MODEL=gemini-2.5-flash

# Supabase (Stride Probe project)
SUPABASE_URL=https://vjbhmyyeqenlypyqufgd.supabase.co
SUPABASE_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=

# Security & Secrets
EBB_SECRET_KEY=change-me-to-a-long-random-string-of-32-plus-chars
